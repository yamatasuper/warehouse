<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                 xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_1"
                 targetNamespace="http://bpmn.io/schema/bpmn"
                 exporter="Camunda Modeler"
                 exporterVersion="4.12.0">

  <bpmn:process id="Process_0twprp2" name="Order Confirmation Process" isExecutable="true" camunda:historyTimeToLive="365">

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Order Received">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Compliance Check Service Task -->
    <bpmn:serviceTask id="ServiceTask_1" name="Compliance Check"
                     camunda:expression="${complianceCheckWorker.checkCompliance(execution)}">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway for Compliance Result -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Compliance Approved?">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Compliance Approved Path -->
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${complianceApproved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Compliance Rejected Path -->
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${complianceApproved == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Create Contract Service Task -->
    <bpmn:serviceTask id="ServiceTask_2" name="Create Contract"
                     camunda:delegateExpression="${createContractDelegate}">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Schedule Delivery Service Task -->
    <bpmn:serviceTask id="ServiceTask_3" name="Schedule Delivery"
                     camunda:delegateExpression="${scheduleDeliveryDelegate}">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Process Payment Service Task -->
    <bpmn:serviceTask id="ServiceTask_4" name="Process Payment"
                     camunda:delegateExpression="${processPaymentDelegate}">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Update Order Status Service Task -->
    <bpmn:serviceTask id="ServiceTask_6" name="Update Order Status to Confirmed"
                     camunda:expression="${orderOrchestrationService.updateOrderStatus(orderId, 'CONFIRMED')}">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Reject Order Service Task -->
    <bpmn:serviceTask id="ServiceTask_5" name="Reject Order"
                     camunda:expression="${orderOrchestrationService.updateOrderStatus(orderId, 'REJECTED')}">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event for Confirmed Order -->
    <bpmn:endEvent id="EndEvent_1" name="Order Confirmed">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event for Rejected Order -->
    <bpmn:endEvent id="EndEvent_2" name="Order Rejected">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ServiceTask_1" />
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1" />
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="ServiceTask_2" targetRef="ServiceTask_3" />
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ServiceTask_3" targetRef="ServiceTask_4" />
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="ServiceTask_4" targetRef="ServiceTask_6" />
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="ServiceTask_6" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="ServiceTask_5" targetRef="EndEvent_2" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_0twprp2">

      <!-- Start Event -->
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Compliance Check -->
      <bpmndi:BPMNShape id="_BPMNShape_ServiceTask_1" bpmnElement="ServiceTask_1">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway -->
      <bpmndi:BPMNShape id="_BPMNShape_ExclusiveGateway_1" bpmnElement="ExclusiveGateway_1">
        <dc:Bounds x="390" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Create Contract -->
      <bpmndi:BPMNShape id="_BPMNShape_ServiceTask_2" bpmnElement="ServiceTask_2">
        <dc:Bounds x="490" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Schedule Delivery -->
      <bpmndi:BPMNShape id="_BPMNShape_ServiceTask_3" bpmnElement="ServiceTask_3">
        <dc:Bounds x="640" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Process Payment -->
      <bpmndi:BPMNShape id="_BPMNShape_ServiceTask_4" bpmnElement="ServiceTask_4">
        <dc:Bounds x="790" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Update Order Status -->
      <bpmndi:BPMNShape id="_BPMNShape_ServiceTask_6" bpmnElement="ServiceTask_6">
        <dc:Bounds x="940" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Reject Order -->
      <bpmndi:BPMNShape id="_BPMNShape_ServiceTask_5" bpmnElement="ServiceTask_5">
        <dc:Bounds x="490" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- End Events -->
      <bpmndi:BPMNShape id="_BPMNShape_EndEvent_1" bpmnElement="EndEvent_1">
        <dc:Bounds x="1092" y="55" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="_BPMNShape_EndEvent_2" bpmnElement="EndEvent_2">
        <dc:Bounds x="640" y="185" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Sequence Flows -->
      <bpmndi:BPMNEdge id="_BPMNEdge_SequenceFlow_1" bpmnElement="SequenceFlow_1">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="_BPMNEdge_SequenceFlow_2" bpmnElement="SequenceFlow_2">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="390" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="_BPMNEdge_SequenceFlow_3" bpmnElement="SequenceFlow_3">
        <di:waypoint x="415" y="95" />
        <di:waypoint x="415" y="70" />
        <di:waypoint x="490" y="70" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="_BPMNEdge_SequenceFlow_4" bpmnElement="SequenceFlow_4">
        <di:waypoint x="415" y="145" />
        <di:waypoint x="415" y="200" />
        <di:waypoint x="490" y="200" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="_BPMNEdge_SequenceFlow_5" bpmnElement="SequenceFlow_5">
        <di:waypoint x="590" y="70" />
        <di:waypoint x="640" y="70" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="_BPMNEdge_SequenceFlow_6" bpmnElement="SequenceFlow_6">
        <di:waypoint x="740" y="70" />
        <di:waypoint x="790" y="70" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="_BPMNEdge_SequenceFlow_7" bpmnElement="SequenceFlow_7">
        <di:waypoint x="890" y="70" />
        <di:waypoint x="940" y="70" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="_BPMNEdge_SequenceFlow_8" bpmnElement="SequenceFlow_8">
        <di:waypoint x="1040" y="70" />
        <di:waypoint x="1092" y="73" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="_BPMNEdge_SequenceFlow_9" bpmnElement="SequenceFlow_9">
        <di:waypoint x="590" y="200" />
        <di:waypoint x="640" y="203" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>