<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="insert-test-products" author="movchanart">
        <!-- Первый продукт -->
        <insert tableName="products">
            <column name="id" valueComputed="RANDOM_UUID()"/>
            <column name="name" value="Смартфон Samsung Galaxy S23"/>
            <column name="article" value="SM-S911BZKDSEK"/>
            <column name="description" value="Флагманский смартфон с динамическим AMOLED 2X экраном 6.1&quot;"/>
            <column name="category" value="ELECTRONICS"/>
            <column name="price" valueNumeric="799.99"/>
            <column name="quantity" valueNumeric="25"/>
            <column name="last_quantity_change" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>

        <!-- Второй продукт -->
        <insert tableName="products">
            <column name="id" valueComputed="RANDOM_UUID()"/>
            <column name="name" value="Ноутбук Apple MacBook Pro 16&quot;"/>
            <column name="article" value="MK183LL/A"/>
            <column name="description" value="Профессиональный ноутбук с процессором M2 Pro"/>
            <column name="category" value="ELECTRONICS"/>
            <column name="price" valueNumeric="2499.00"/>
            <column name="quantity" valueNumeric="10"/>
            <column name="last_quantity_change" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>

        <!-- Третий продукт -->
        <insert tableName="products">
            <column name="id" valueComputed="RANDOM_UUID()"/>
            <column name="name" value="Кофеварка DeLonghi Magnifica S"/>
            <column name="article" value="ECAM22.110.B"/>
            <column name="description" value="Автоматическая кофеварка с капучинатором"/>
            <column name="category" value="ELECTRONICS"/>
            <column name="price" valueNumeric="549.99"/>
            <column name="quantity" valueNumeric="15"/>
            <column name="last_quantity_change" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
    </changeSet>
</databaseChangeLog>