<bpmn:process id="order-orchestration" isExecutable="true">
  <bpmn:startEvent id="StartEvent"/>
  <bpmn:sequenceFlow sourceRef="StartEvent" targetRef="Task_Compliance"/>

  <bpmn:serviceTask id="Task_Compliance" name="Compliance Check"
      camunda:type="external" camunda:topic="compliance-check"/>
  <bpmn:sequenceFlow sourceRef="Task_Compliance" targetRef="Task_Contract"/>

  <bpmn:serviceTask id="Task_Contract" name="Register Contract"
      camunda:type="external" camunda:topic="register-contract"/>
  <bpmn:sequenceFlow sourceRef="Task_Contract" targetRef="Task_Delivery"/>

  <bpmn:serviceTask id="Task_Delivery" name="Register Delivery"
      camunda:type="external" camunda:topic="register-delivery"/>
  <bpmn:sequenceFlow sourceRef="Task_Delivery" targetRef="Task_Payment"/>

  <bpmn:serviceTask id="Task_Payment" name="Make Payment"
      camunda:type="external" camunda:topic="make-payment"/>
  <bpmn:sequenceFlow sourceRef="Task_Payment" targetRef="EndEvent"/>

  <bpmn:endEvent id="EndEvent"/>
</bpmn:process>
