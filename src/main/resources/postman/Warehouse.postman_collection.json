          "raw": "{\n  \"name\": \"MacBook Pro Updated\",\n  \"description\": \"16-inch M2 Max (Updated)\",\n  \"category\": \"ELECTRONICS\",\n  \"price\": 3199.99,\n  \"quantity\": 5\n}",
          "options": {
